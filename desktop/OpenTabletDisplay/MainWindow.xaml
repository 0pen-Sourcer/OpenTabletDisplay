<Window x:Class="OpenTabletDisplay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenTabletDisplay" Width="1190" Height="810" MinWidth="1000" MinHeight="690"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        Loaded="Window_Loaded" Closing="Window_Closing" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="255"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="#243850" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True" Margin="18,26,18,22">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="6,4,0,40">
                        <Border Background="#203C6B" CornerRadius="12" Width="48" Height="48">
                            <Image x:Name="BrandImage" Width="46" Height="46" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel Margin="12,5,0,0">
                            <TextBlock Text="OpenTablet" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="DISPLAY" FontSize="10" Foreground="#8BB6FF" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="WORKSPACE" Style="{StaticResource Eyebrow}" Foreground="#647E9D" Margin="17,0,0,13"/>
                    <Button x:Name="NavOverview" Content="◉   Overview" Style="{StaticResource NavButton}" Click="NavOverview_Click"/>
                    <Button x:Name="NavSetup" Content="＋   Set up &amp; connect" Style="{StaticResource NavButton}" Click="NavSetup_Click"/>
                    <Button x:Name="NavDevices" Content="▣   My devices" Style="{StaticResource NavButton}" Click="NavDevices_Click"/>
                    <Button x:Name="NavDiagnostics" Content="≡   Diagnostics" Style="{StaticResource NavButton}" Click="NavDiagnostics_Click"/>
                    <Button x:Name="NavSettings" Content="⚙   Preferences &amp; help" Style="{StaticResource NavButton}" Click="NavSettings_Click"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                    <Border CornerRadius="9" Background="#1C2A3D" Padding="12,11">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="SidebarStateDot" Width="9" Height="9" Fill="#F6B966" Margin="0,4,9,0"/>
                            <TextBlock x:Name="SidebarStateText" Text="Checking components" FontSize="12" Foreground="#D5E3F5"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Windows 10 / 11 • Preview build" Foreground="#7189A6" Margin="7,14,0,0" FontSize="11"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ScrollViewer x:Name="MainScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="36,30,34,30">
                    <Grid Margin="0,0,0,26">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="PageEyebrow" Text="YOUR WORKSPACE" Style="{StaticResource Eyebrow}"/>
                            <TextBlock x:Name="PageHeading" Text="Overview" Style="{StaticResource Title}" Margin="0,6,0,6"/>
                            <TextBlock x:Name="PageSubheading" Text="Connect your Android device as an additional Windows display." Style="{StaticResource Muted}"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="RefreshButton" Content="↻  Refresh status" Style="{StaticResource SecondaryButton}" Margin="15,6,0,0" VerticalAlignment="Center" Click="RefreshButton_Click"/>
                    </Grid>

                    <StackPanel x:Name="OverviewPage">
                        <Border Background="#1B3152" BorderBrush="#355480" BorderThickness="1" CornerRadius="20" Padding="29" Margin="0,0,0,24">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,20,0">
                                    <TextBlock Text="OPEN TABLET DISPLAY" Style="{StaticResource Eyebrow}" Foreground="#A6CDFF"/>
                                    <TextBlock x:Name="HeroHeading" Text="Make room for more." FontSize="26" FontWeight="SemiBold" Margin="0,11,0,9"/>
                                    <TextBlock x:Name="HeroDescription" Text="Turn your Android tablet into an extended Windows display over USB." Style="{StaticResource Muted}" FontSize="14" Foreground="#BDD3F1" MaxWidth="500"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                                        <Button x:Name="HeroPrimaryButton" Content="Set up my display" Style="{StaticResource PrimaryButton}" Click="HeroPrimary_Click" Margin="0,0,10,0"/>
                                        <Button Content="View diagnostics" Style="{StaticResource SecondaryButton}" Click="GoDiagnostics_Click"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="1" Width="145" Height="130" Background="#294D7A" CornerRadius="18" VerticalAlignment="Center">
                                    <Image x:Name="HeroImage" Width="116" Height="116" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                            </Grid>
                        </Border>
                        <TextBlock Text="SYSTEM HEALTH" Style="{StaticResource Eyebrow}" Margin="0,0,0,13"/>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,14">
                                <StackPanel><TextBlock Text="APPLICATION" Style="{StaticResource Eyebrow}"/>
                                    <TextBlock x:Name="AppStatusText" Text="Checking…" FontSize="20" FontWeight="SemiBold" Margin="0,10,0,5"/>
                                    <TextBlock x:Name="AppDetailText" Text="Inspecting installed components" Style="{StaticResource Muted}"/></StackPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="SUNSHINE" Style="{StaticResource Eyebrow}"/>
                                    <TextBlock x:Name="SunshineStatusText" Text="Checking…" FontSize="20" FontWeight="SemiBold" Margin="0,10,0,5"/>
                                    <TextBlock x:Name="SunshineReachabilityText" Text="Checking the local streaming endpoint…" Style="{StaticResource Muted}"/>
                                    <WrapPanel Margin="0,13,0,0">
                                        <Button x:Name="SunshineStartButton" Content="Start" Style="{StaticResource PrimaryButton}" Click="StartSunshine_Click" Margin="0,0,8,0" IsEnabled="False"/>
                                        <Button x:Name="SunshineStopButton" Content="Stop" Style="{StaticResource SecondaryButton}" Click="StopSunshine_Click" IsEnabled="False"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                                <StackPanel><TextBlock Text="VIRTUAL DISPLAY" Style="{StaticResource Eyebrow}"/>
                                    <TextBlock x:Name="DriverStatusText" Text="Checking…" FontSize="20" FontWeight="SemiBold" Margin="0,10,0,5"/>
                                    <TextBlock Text="Hardware-identified monitor adapter" Style="{StaticResource Muted}"/></StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                                <StackPanel><TextBlock Text="ANDROID DEVICE" Style="{StaticResource Eyebrow}"/>
                                    <TextBlock x:Name="AndroidStatusText" Text="Checking…" FontSize="20" FontWeight="SemiBold" Margin="0,10,0,5"/>
                                    <TextBlock Text="Authorized USB connection" Style="{StaticResource Muted}"/></StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource Card}">
                            <StackPanel><TextBlock Text="HOW IT WORKS" Style="{StaticResource Eyebrow}"/>
                                <TextBlock Text="Windows → virtual screen → Sunshine → USB → Moonlight" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,6"/>
                                <TextBlock Text="Connect a tablet or phone and use Windows display settings to arrange your screens." Style="{StaticResource Muted}"/></StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="SetupPage" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="01   PREPARE WINDOWS" Style="{StaticResource Eyebrow}"/>
                                <TextBlock x:Name="SetupStepHeading" Text="Install OpenTabletDisplay" Style="{StaticResource Heading}" Margin="0,11,0,8"/>
                                <TextBlock x:Name="SetupStepDescription" Text="Install and configure Sunshine and the display driver. Windows will request administrator approval. Existing settings will be preserved where possible." Style="{StaticResource Muted}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <Button x:Name="InstallButton" Content="Install / repair" Style="{StaticResource PrimaryButton}" Click="InstallButton_Click" Margin="0,0,10,0"/>
                                    <Button Content="Inspect installer log" Style="{StaticResource SecondaryButton}" Click="GoDiagnostics_Click"/>
                                </StackPanel>
                                <ProgressBar x:Name="InstallProgress" Visibility="Collapsed" Height="5" Margin="0,20,0,12" IsIndeterminate="True" Background="#273F60" Foreground="#64B5FF"/>
                                <TextBlock x:Name="InstallDetailText" Text="Ready to check Windows." Style="{StaticResource Muted}" Margin="0,13,0,0"/>
                                <TextBlock x:Name="InstallerWarning" Text="" Foreground="#F2BE7C" Margin="0,10,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="02   CONNECT ANDROID" Style="{StaticResource Eyebrow}"/>
                                <TextBlock Text="Connect a USB data cable." Style="{StaticResource Heading}" Margin="0,11,0,8"/>
                                <TextBlock Text="Unlock Android, enable Developer options and USB debugging, and authorize this PC when Android asks. Leave regular USB tethering OFF." Style="{StaticResource Muted}"/>
                                <TextBlock Text="Android may request permission for a local gnirehtet VPN. That permission cannot be bypassed." Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <Button x:Name="CheckUsbButton" Content="Check USB device" Style="{StaticResource SecondaryButton}" Click="CheckUsbButton_Click"/>
                                    <TextBlock x:Name="UsbSetupStatus" Text="Not checked" Foreground="#AAC1DC" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="13"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="03   PAIR MOONLIGHT" Style="{StaticResource Eyebrow}"/>
                                <TextBlock Text="Open Moonlight on your Android device." Style="{StaticResource Heading}" Margin="0,11,0,8"/>
                                <TextBlock Text="After USB transport is ready, add the host address to Moonlight and enter the displayed PIN into Sunshine's local control panel." Style="{StaticResource Muted}"/>
                                <Border Background="#0E192B" CornerRadius="11" Margin="0,16,0,16" Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="MOONLIGHT HOST ADDRESS" Style="{StaticResource Eyebrow}"/>
                                            <TextBlock x:Name="HostAddressText" Text="Not yet connected" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel>
                                        <Button Grid.Column="1" Content="Copy address" Style="{StaticResource SecondaryButton}" Click="CopyHostButton_Click" Margin="12,0,0,0"/>
                                    </Grid>
                                </Border>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Get Moonlight" Style="{StaticResource SecondaryButton}" Click="MoonlightButton_Click" Margin="0,0,10,0"/>
                                    <Button Content="Sunshine settings" Style="{StaticResource SecondaryButton}" Click="SunshineButton_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="DevicesPage" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,19">
                            <StackPanel>
                                <TextBlock Text="ANDROID DEVICE MANAGER" Style="{StaticResource Eyebrow}"/>
                                <TextBlock Text="Your USB-connected screen." Style="{StaticResource Heading}" Margin="0,10,0,8"/>
                                <TextBlock Text="Only devices you authorize in Android's USB debugging prompt can be enrolled. Multiple devices are never selected automatically." Style="{StaticResource Muted}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,18,0,12">
                                    <Button x:Name="ScanDeviceButton" Content="Scan connected Android devices" Style="{StaticResource PrimaryButton}" Click="CheckUsbButton_Click" Margin="0,0,11,0"/>
                                    <TextBlock x:Name="DeviceScanStatus" Text="No scan yet" VerticalAlignment="Center" Style="{StaticResource Muted}"/>
                                </StackPanel>
                                <ListBox x:Name="DeviceList" Height="154" Background="#0D182A" Foreground="#E7F1FF" BorderBrush="#3A5273" BorderThickness="1" FontFamily="Segoe UI" FontSize="13"/>
                                <Button x:Name="EnrollButton" Content="Use selected authorized device" Style="{StaticResource SecondaryButton}" Click="EnrollButton_Click" IsEnabled="False" Margin="0,16,0,0" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="WIRED CONNECTION" Style="{StaticResource Eyebrow}"/>
                                <TextBlock Text="Reconnect after the first setup." Style="{StaticResource Heading}" Margin="0,10,0,8"/>
                                <TextBlock Text="Once Windows setup has completed, use the background agent to connect on future USB plug-ins. Connection controls are disabled during installation to prevent conflicts." Style="{StaticResource Muted}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,19,0,0">
                                    <Button x:Name="StartUsbButton" Content="Start / repair connection" Style="{StaticResource PrimaryButton}" Click="StartUsbButton_Click" Margin="0,0,11,0" IsEnabled="False"/>
                                    <Button x:Name="StopUsbButton" Content="Stop connection" Style="{StaticResource SecondaryButton}" Click="StopUsbButton_Click" IsEnabled="False"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="DiagnosticsPage" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,17">
                            <StackPanel>
                                <TextBlock Text="LOCAL TROUBLESHOOTING" Style="{StaticResource Eyebrow}"/>
                                <TextBlock Text="See exactly what happened." Style="{StaticResource Heading}" Margin="0,10,0,8"/>
                                <TextBlock Text="Installation logs, USB transport results and dependency-download errors stay on your PC. No diagnostic data is sent anywhere automatically." Style="{StaticResource Muted}"/>
                                <WrapPanel Margin="0,17,0,0">
                                    <Button x:Name="DoctorButton" Content="Run connection doctor" Style="{StaticResource PrimaryButton}" Click="DoctorButton_Click" Margin="0,0,10,10"/>
                                    <Button Content="Export sanitized report" Style="{StaticResource SecondaryButton}" Click="ExportButton_Click" Margin="0,0,10,10"/>
                                    <Button Content="Open logs folder" Style="{StaticResource SecondaryButton}" Click="LogsFolderButton_Click" Margin="0,0,10,10"/>
                                    <Button Content="Refresh output" Style="{StaticResource SecondaryButton}" Click="RefreshLogsButton_Click" Margin="0,0,10,10"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="11">
                            <StackPanel>
                                <TextBlock Text="RECENT ACTIVITY" Style="{StaticResource Eyebrow}" Margin="10,4,0,12"/>
                                <TextBox x:Name="DiagnosticsOutput" Style="{StaticResource DarkTextBox}"
                                         Height="405" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                         HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                         Text="No diagnostics loaded."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="SUNSHINE" Style="{StaticResource Eyebrow}"/>
                                <TextBlock Text="Streaming service" Style="{StaticResource Heading}" Margin="0,10,0,8"/>
                                <TextBlock Text="Turn streaming on when you need your tablet, and off when you're done. Your pairing and virtual display are kept." Style="{StaticResource Muted}"/>
                                <TextBlock x:Name="SunshineServiceDetail" Text="Checking Sunshine service…" Style="{StaticResource Muted}" Margin="0,12,0,0"/>
                                <WrapPanel Margin="0,16,0,0">
                                    <Button x:Name="SunshineSettingsStartButton" Content="Start Sunshine" Style="{StaticResource PrimaryButton}" Click="StartSunshine_Click" Margin="0,0,10,10" IsEnabled="False"/>
                                    <Button x:Name="SunshineSettingsStopButton" Content="Stop Sunshine" Style="{StaticResource SecondaryButton}" Click="StopSunshine_Click" Margin="0,0,10,10" IsEnabled="False"/>
                                </WrapPanel>
                                <TextBlock Text="WHEN WINDOWS STARTS" Style="{StaticResource Eyebrow}" Margin="0,18,0,0"/>
                                <TextBlock x:Name="SunshineStartupText" Text="Checking startup preference…" Style="{StaticResource Muted}" Margin="0,9,0,0"/>
                                <WrapPanel Margin="0,14,0,0">
                                    <Button x:Name="SunshineAutomaticButton" Content="Start automatically" Style="{StaticResource SecondaryButton}" Click="SunshineAutomatic_Click" Margin="0,0,10,10" IsEnabled="False"/>
                                    <Button x:Name="SunshineManualButton" Content="Start manually" Style="{StaticResource SecondaryButton}" Click="SunshineManual_Click" Margin="0,0,10,10" IsEnabled="False"/>
                                </WrapPanel>
                                <TextBlock Text="This changes only Sunshine's Windows service setting. It doesn't start or stop your stream immediately." Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="PRIVACY &amp; TRUST" Style="{StaticResource Eyebrow}"/>
                                <TextBlock Text="Security &amp; permissions" Style="{StaticResource Heading}" Margin="0,10,0,8"/>
                                <TextBlock Text="Review the components OpenTabletDisplay uses and the permissions they require." Style="{StaticResource Muted}"/>
                                <TextBlock Text="If security software blocks the unsigned transport engine, review the detection and request publisher verification. Never disable protection to force installation." Foreground="#F5BD7C" Margin="0,12,0,0" FontSize="13"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="SUPPORT" Style="{StaticResource Eyebrow}"/>
                                <TextBlock Text="Useful links, not mystery dialogs." Style="{StaticResource Heading}" Margin="0,10,0,8"/>
                                <WrapPanel Margin="0,16,0,0">
                                    <Button Content="Troubleshooting guide" Style="{StaticResource SecondaryButton}" Click="HelpButton_Click" Margin="0,0,10,10"/>
                                    <Button Content="Report an issue" Style="{StaticResource SecondaryButton}" Click="ReportButton_Click" Margin="0,0,10,10"/>
                                    <Button Content="Open app folder" Style="{StaticResource SecondaryButton}" Click="AppFolderButton_Click" Margin="0,0,10,10"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="UNINSTALL" Style="{StaticResource Eyebrow}"/>
                                <TextBlock Text="Remove the OpenTabletDisplay integration." Style="{StaticResource Heading}" Margin="0,10,0,8"/>
                                <TextBlock Text="Confirms before changing the system. Existing Sunshine and virtual-display drivers are preserved by default." Style="{StaticResource Muted}"/>
                                <Button x:Name="UninstallButton" Content="Uninstall integration" Style="{StaticResource SecondaryButton}" Click="UninstallButton_Click" Margin="0,18,0,0" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="1" Background="#101C2B" BorderBrush="#2A3B54" BorderThickness="0,1,0,0" Padding="26,13">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="FooterText" Text="Checking component health…" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FontSize="12" Foreground="#D1E1F5" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="OpenTabletDisplay" FontSize="11" Foreground="#7896BB" VerticalAlignment="Center" Margin="15,0,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>