<Window x:Class="OpenTabletDisplay.UninstallSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose what to remove · OpenTabletDisplay"
        Width="670" Height="592" MinWidth="580"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="#0B1320" Foreground="#EDF4FF"
        FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E7F0FF"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Background" Value="#427EED"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="Background" Value="#273952"/>
        </Style>
    </Window.Resources>
    <Grid Margin="26,22,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="UNINSTALL" FontSize="11" FontWeight="Bold" Foreground="#8AAEEC"/>
            <TextBlock Text="Choose what to remove" FontSize="27" FontWeight="SemiBold" Margin="0,6,0,8"/>
            <TextBlock Text="Only the components you select will be removed. Nothing happens until you confirm."
                       Foreground="#B5C9E5" TextWrapping="Wrap"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,12">
            <StackPanel>
                <Border Background="#162439" CornerRadius="12" Padding="18,14" Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox x:Name="AppCheck" Content="OpenTabletDisplay &amp; USB integration"
                                  IsChecked="True" IsEnabled="False"/>
                        <TextBlock Text="Required. Removes OpenTabletDisplay, its USB connection agent, local files, and app-owned configuration changes."
                                   Foreground="#AABFDB" TextWrapping="Wrap" Margin="24,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#162439" CornerRadius="12" Padding="18,14" Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox x:Name="SunshineCheck" Content="Sunshine streaming service"
                                  IsChecked="False"/>
                        <TextBlock x:Name="SunshineDetail" Foreground="#AABFDB" TextWrapping="Wrap"
                                   Margin="24,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#162439" CornerRadius="12" Padding="18,14" Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox x:Name="DriverCheck" Content="Virtual display device"
                                  IsChecked="False"/>
                        <TextBlock x:Name="DriverDetail" Foreground="#AABFDB" TextWrapping="Wrap"
                                   Margin="24,8,0,0"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="Sunshine or the virtual display may be used by other applications. Leave them unchecked unless you want them removed. Driver package files can remain in Windows even after an owned device is removed."
                           Foreground="#DDB785" TextWrapping="Wrap" FontSize="12"/>
            </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Row="2" LastChildFill="False">
            <TextBlock Text="Default: keep shared dependencies"
                       VerticalAlignment="Center" Foreground="#AAC0DD" FontSize="12"
                       DockPanel.Dock="Left"/>
            <Button Content="Cancel" Style="{StaticResource Secondary}"
                    DockPanel.Dock="Right" Margin="9,0,0,0"
                    IsCancel="True" Click="Cancel_Click"/>
            <Button Content="Continue" Style="{StaticResource Action}"
                    DockPanel.Dock="Right" IsDefault="True" Click="Continue_Click"/>
        </DockPanel>
    </Grid>
</Window>
